# Required. Files are stored in this GitHub repo, not on the server disk.
# The token needs read and write access to the repository contents.
# On a private repo, a classic token needs the repo scope.
GITHUB_TOKEN=
GITHUB_REPO=groksup/research-data
GITHUB_BRANCH=main

# Optional. When set, the dashboard asks for this passphrase.
# The upload and download API stay open either way.
DASHBOARD_PASSWORD=

# Optional. When set, uploads must send header X-Upload-Key.
# Leave empty to keep the endpoint open.
UPLOAD_KEY=

# Max upload size in bytes. Default and cap are 4194304 (4 MB),
# which stays under Vercel's request body limit.
MAX_UPLOAD_BYTES=4194304
